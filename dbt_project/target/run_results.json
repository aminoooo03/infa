p_products", "compiled": true, "compiled_code": "\nWITH clicks AS (\n  SELECT product_id, click_count \n  FROM `my-project-lab1-497719`.`dwh`.`popular_products`\n),\norders AS (\n  SELECT product_id, SUM(quantity) as total_orders \n  FROM `my-project-lab1-497719.raw.orders` \n  GROUP BY product_id\n)\nSELECT \n  c.product_id, \n  c.click_count*0.7 + COALESCE(o.total_orders,0)*0.3 as score\nFROM clicks c \nLEFT JOIN orders o ON c.product_id = o.product_id\nORDER BY score DESC \nLIMIT 10", "relation_name": "`my-project-lab1-497719`.`dwh`.`top_products`", "batch_results": null}], "elapsed_time": 6.306403636932373, "args": {"log_path": "/home/nakovaamina3/dbt_project/logs", "print": true, "use_colors": true, "invocation_command": "dbt run", "require_yaml_configuration_for_mf_time_spines": false, "log_format_file": "debug", "send_anonymous_usage_stats": true, "static_parser": true, "require_nested_cumulative_type_params": false, "partial_parse_file_diff": true, "populate_cache": true, "vars": {}, "project_dir": "/home/nakovaamina3/dbt_project", "version_check": true, "cache_selected_only": false, "log_level": "info", "state_modified_compare_more_unrendered_values": false, "show_all_deprecations": false, "use_colors_file": true, "which": "run", "log_format": "default", "state_modified_compare_vars": false, "select": [], "require_ref_searches_node_package_before_root": false, "exclude": [], "require_resource_names_without_spaces": true, "log_file_max_bytes": 10485760, "favor_state": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "skip_nodes_if_on_run_start_fails": false, "profiles_dir": "/home/nakovaamina3/.dbt", "require_batched_execution_for_custom_microbatch_strategy": false, "require_explicit_package_overrides_for_builtin_materializations": true, "require_unique_project_resource_names": false, "source_freshness_run_project_hooks": true, "use_fast_test_edges": false, "defer": false, "strict_mode": false, "upload_to_artifacts_ingest_api": f